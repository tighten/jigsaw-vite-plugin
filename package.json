{
    "name": "@tighten/jigsaw-vite-plugin",
    "version": "2.0.0",
    "description": "Jigsaw plugin for Vite.",
    "keywords": [
        "jigsaw",
        "vite",
        "vite-plugin"
    ],
    "homepage": "https://github.com/tighten/jigsaw-vite-plugin",
    "repository": {
        "type": "git",
        "url": "https://github.com/tighten/jigsaw-vite-plugin"
    },
    "license": "MIT",
    "author": "Tighten",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "/dist"
    ],
    "scripts": {
        "build": "npm run build-plugin",
        "build-plugin": "rm -rf dist && npm run build-plugin-types && npm run build-plugin-esm && cp src/dev-server-index.html dist/",
        "build-plugin-types": "tsc --emitDeclarationOnly",
        "build-plugin-esm": "esbuild src/*.ts --platform=node --format=esm --outdir=dist",
        "test": "vitest run"
    },
    "dependencies": {
        "picocolors": "^1.0.0",
        "picomatch": "^2.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/picomatch": "^2.3.0",
        "esbuild": "^0.28.0",
        "prettier": "^3.5.1",
        "typescript": "^5.4.0",
        "vite": "^8.0.0",
        "vitest": "^2.1.0"
    },
    "peerDependencies": {
        "vite": "^8.0.0"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
